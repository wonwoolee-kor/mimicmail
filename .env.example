# CLI 옵션 > 실행 환경변수 > 이 파일 > 기본값
# 필요한 항목의 주석을 해제하고 .env에 저장하세요.

MIMICMAIL_DB=data/mimicmail.sqlite3
MIMICMAIL_BACKEND=codex
MIMICMAIL_PORT=8765
# MIMICMAIL_USER=me@example.com

# Codex: 모델을 생략하면 Codex CLI의 기본 설정을 사용합니다.
# CODEX_MODEL=your-model

# OpenAI API: MIMICMAIL_BACKEND=openai와 함께 설정합니다.
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=your-model

# Gmail: wonwoolee.fwd@gmail.com 전용. 연결 후 true로 바꾸면 GUI 실행 중 자동 수집합니다.
GMAIL_ENABLED=false
GMAIL_POLL_SECONDS=120
# Google Cloud에서 Desktop app OAuth 클라이언트를 생성합니다. 설정 절차: README.
# GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-client-secret
# 기존 보관함과 합치려면 위 MIMICMAIL_USER에 기존 본인 주소를 설정하세요.
# 생략하면 Gmail 수집의 소유자로 wonwoolee.fwd@gmail.com을 사용합니다.
# 본인이 실제로 사용하는 추가 발신 주소를 쉼표로 구분합니다.
# MIMICMAIL_ALIASES=me@company.example,me@another.example
# OAuth 토큰은 .env에 넣지 않습니다. macOS에서는 키체인에 저장합니다.

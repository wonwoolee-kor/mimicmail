# CLI 옵션 > 실행 환경변수 > 이 파일 > 기본값
# 필요한 항목의 주석을 해제하고 .env에 저장하세요.

MIMICMAIL_DB=data/mimicmail.sqlite3
MIMICMAIL_BACKEND=codex
MIMICMAIL_PORT=8765
# MIMICMAIL_USER=me@example.com

# Codex: 모델을 생략하면 Codex CLI의 기본 설정을 사용합니다.
# CODEX_MODEL=your-model

# OpenAI API: MIMICMAIL_BACKEND=openai와 함께 설정합니다.
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=your-model
